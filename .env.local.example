# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── NextAuth ───────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Claude API (Anthropic) ──────────────────────────────────────────────────
# Used server-side only (API routes), for content synthesis and the chat
# companion / check-in tip phrasing.
ANTHROPIC_API_KEY=

# ── Cron auth ────────────────────────────────────────────────────────────────
# Protects /api/cron/prewarm-content. Generate with: openssl rand -hex 24
# On Vercel, set this same value as a project env var — Vercel automatically
# sends it as a Bearer token on cron-triggered requests (see vercel.json).
CRON_SECRET=

# ── Resend (email) ─────────────────────────────────────────────────────────
# Used for appointment reminder emails — not needed until that feature is built.
RESEND_API_KEY=

# ── Signup access ────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_SIGNUP_MODE=open (and redeploy) to make /signup public —
# a single env var flip, no code changes. Any other value (or unset) keeps
# signup invite-only and requires SIGNUP_INVITE_CODE below to match.
NEXT_PUBLIC_SIGNUP_MODE=invite
SIGNUP_INVITE_CODE=
